{
  "name": "civicneuro",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build-runtime-config.js",
    "build:vendor:supabase": "esbuild node_modules/@supabase/supabase-js/dist/index.mjs --bundle --format=esm --platform=browser --target=es2022 --outfile=apps/resident-pwa/vendor/supabase-js.js",
    "build:vendor:zego": "esbuild scripts/zego-browser-entry.js --bundle --format=esm --platform=browser --target=es2022 --outfile=apps/resident-pwa/vendor/zego-uikit.js",
    "build:vendor": "npm run build:vendor:supabase && npm run build:vendor:zego",
    "test": "node --test packages/*/test/*.test.js apps/resident-pwa/test/*.test.js tests/beacon/*.test.js supabase/functions/beacon-route/handler.test.js supabase/functions/snap-and-say/handler.test.js supabase/functions/zego-token/handler.test.js",
    "lint": "eslint .",
    "check:innerhtml": "node tools/check-no-innerhtml.js",
    "check:inline-scripts": "node tools/check-no-inline-scripts.js",
    "check:service-role": "node tools/check-service-role-usage.js",
    "check:forbidden-stack": "node tools/check-forbidden-stack.js",
    "check:boundaries": "node tools/check-boundaries.js",
    "check:layout": "node tools/check-layout.js",
    "check:imports": "node tools/check-imports.js",
    "check:csp": "node tools/check-csp.js",
    "check:no-secrets": "node tools/check-no-secrets.js",
    "check:all": "npm run check:innerhtml && npm run check:inline-scripts && npm run check:service-role && npm run check:forbidden-stack && npm run check:boundaries && npm run check:layout && npm run check:imports",
    "test:sql:dev": "node scripts/run-supabase-sql-tests.js",
    "test:beacon:dev": "node scripts/beacon-circle.e2e.js",
    "test:beacon:browser": "node scripts/beacon-browser.e2e.js",
    "test:alerts:browser": "node scripts/alerts-browser.e2e.js",
    "seed:alert": "node scripts/seed-demo-alert.js",
    "seed:alert:cleanup": "node scripts/seed-demo-alert.js --cleanup",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:demo:cleanup": "node scripts/seed-demo.js --cleanup",
    "db:apply:lifeline-lookup:dev": "node scripts/apply-lifeline-lookup-migration.js",
    "dev": "npm run build:vendor && node tools/dev-server.js",
    "dev:demo": "npm run build:vendor && node tools/dev-server.js --demo",
    "sync-shared": "node tools/sync-shared.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pg": "^8.16.3",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "@zegocloud/zego-uikit-prebuilt": "2.18.4",
    "zego-zim-web": "2.16.0"
  }
}
